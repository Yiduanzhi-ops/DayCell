{
  "name": "daycell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "以「一天」为容器的记录本：待办、想法、花费。月视图看密度，周视图看内容。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "cross-env-shell TZ=UTC vitest run && cross-env-shell TZ=Asia/Shanghai vitest run && cross-env-shell TZ=America/New_York vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "size": "vite build && node scripts/report-size.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lunar-typescript": "^1.8.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
